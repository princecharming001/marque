{
  "name": "yunicorn-studio-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Yunicorn Studio overlay renderer: captions, text overlays, designed cards and graphics as ProRes 4444 with alpha (Remotion).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "bundle": "remotion bundle src/index.ts --out-dir build",
    "typecheck": "tsc --noEmit",
    "fetch-fonts": "node scripts/fetch-fonts.mjs",
    "validate-props": "node scripts/validate-props.mts",
    "render:example": "remotion render src/index.ts Overlay out/example.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png --color-space=bt709 --muted"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/captions": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/layout-utils": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}

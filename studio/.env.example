# Yunicorn Studio configuration. Copy the names you need into your own env file and point
# STUDIO_ENV_FILE at it. Values are never printed, logged or persisted by Studio.

# --- paths / behaviour ---
STUDIO_WORK_DIR=
STUDIO_MODELS_DIR=
STUDIO_SKILLS_DIR=
STUDIO_OVERLAY_DIR=
STUDIO_FFMPEG=
STUDIO_FFPROBE=
STUDIO_RUBBERBAND=
# headless Chrome for the Remotion overlay render (default: Remotion's own download)
STUDIO_REMOTION_BROWSER=
# 1 = allow tests marked @pytest.mark.real to hit real APIs
STUDIO_REAL=

# --- house model ids (optional overrides) ---
STUDIO_DIRECTOR_PROVIDER=
STUDIO_DIRECTOR_MODEL=
STUDIO_DIRECTOR_FALLBACK_MODEL=
STUDIO_DIRECTOR_EFFORT=
STUDIO_CRITIC_MODEL=
STUDIO_WATCHER_MODEL=

# --- provider keys (names only) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_KEY=
PEXELS_KEY=
HIGGSFIELD_KEY=
